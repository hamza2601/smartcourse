DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartcourse
SERVER_PORT=8080

# "dev" allows a default JWT secret; any other value requires JWT_SECRET (32+ chars)
ENV=dev
JWT_SECRET=
# Optional: an admin user is created at startup if both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
