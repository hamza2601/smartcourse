DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=smartcourse_db

# Public API port, and the internal port serving /internal/* only.
# Never expose INTERNAL_PORT outside the service network or route it via a gateway.
PORT=8082
INTERNAL_PORT=9082

# "dev" allows default JWT_SECRET / INTERNAL_API_KEY; any other value requires
# both to be set (32+ chars). All services must share the same values.
ENV=dev
JWT_SECRET=
INTERNAL_API_KEY=

# Set to "true" when migrations are applied by a separate Liquibase container
SKIP_LIQUIBASE=

# Outbox relay: how often to poll for unpublished events, and how many per batch
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
