DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartcourse
USER_SERVICE_PORT=8081

# "dev" allows a default JWT secret; any other value requires JWT_SECRET (32+ chars).
# All services must share the same JWT_SECRET so tokens verify across services.
ENV=dev
JWT_SECRET=
# Optional: an admin user is created at startup if both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to "true" when migrations are applied by a separate Liquibase container
SKIP_LIQUIBASE=
